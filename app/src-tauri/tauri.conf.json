{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nevar",
  "version": "0.1.0",
  "identifier": "chat.nevar.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nevar",
        "width": 1040,
        "height": 700,
        "minWidth": 420,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "nevar",
    "shortDescription": "Arkadaşlarla sesli sohbet",
    "copyright": "",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}