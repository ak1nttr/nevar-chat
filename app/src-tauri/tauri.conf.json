{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nevar",
  "version": "0.5.0",
  "identifier": "chat.nevar.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "nevar",
        "width": 380,
        "height": 660,
        "minWidth": 340,
        "minHeight": 540,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "nevar",
    "shortDescription": "Arkadaşlarla sesli sohbet",
    "copyright": "",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDRDk0ODAzQjVEQTcyQjYKUldTMmN0cTFBMGpaak9Ydmc1b3d1WDg5YWkyNjA3NU1kWnFuR3dTV3YwY09Va3NXdGhUUmtSYTkK",
      "endpoints": [
        "https://github.com/ak1nttr/nevar-chat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}